page { background: #F6F4EF; }
.home-page { padding: 0 32rpx calc(170rpx + env(safe-area-inset-bottom)); }
.home-login { padding-bottom: 0; }
.login-shell { position: relative; display: flex; width: 100%; min-height: 100vh; padding: calc(88rpx + env(safe-area-inset-top)) 24rpx calc(112rpx + env(safe-area-inset-bottom)); flex-direction: column; justify-content: center; }
.login-main { width: 100%; }
.login-brand { display: flex; width: 100%; margin: 0 0 70rpx; padding: 0 16rpx; flex-direction: column; align-items: flex-start; }
.login-eyebrow, .home-eyebrow { display: block; margin-bottom: 12rpx; color: #8D796E; font-size: 20rpx; font-weight: 650; line-height: 1.25; letter-spacing: 5rpx; }
.login-title { display: block; color: #252824; font-size: 54rpx; font-weight: 700; line-height: 1.25; letter-spacing: 1rpx; }
.login-subtitle { display: block; margin-top: 16rpx; color: #737871; font-size: 26rpx; line-height: 1.7; }
.login-panel { width: 100%; padding: 38rpx 32rpx 32rpx; border: 1rpx solid #E5E0D6; border-radius: 38rpx; background: rgba(255,255,255,.9); box-shadow: 0 24rpx 70rpx rgba(54,49,42,.08); }
.field { width: 100%; margin-bottom: 26rpx; }
.field-label { display: block; margin: 0 0 12rpx 4rpx; color: #515650; font-size: 24rpx; font-weight: 600; line-height: 1.4; }
.login-input { display: block; width: 100%; height: 96rpx; padding: 0 28rpx; border: 1rpx solid #E5E0D6; border-radius: 22rpx; background: #FAF9F6; color: #252824; font-size: 28rpx; line-height: 96rpx; }
.input-placeholder { color: #A5A69F; }
.login-btn { display: flex; width: 100%; height: 96rpx; min-height: 96rpx; margin-top: 12rpx; padding: 0 32rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #2D332F; color: #fff; font-size: 29rpx; font-weight: 650; line-height: 1.2; text-align: center; }
.login-btn::after { border: 0; }
.login-btn-text { display: block; line-height: 1.2; text-align: center; }
.login-btn-active { opacity: .86; transform: scale(.992); }
.login-hint { display: block; margin-top: 24rpx; color: #92968F; font-size: 22rpx; line-height: 1.5; text-align: center; }
.login-footnote { position: absolute; right: 24rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); left: 24rpx; display: block; color: #A09D95; font-size: 21rpx; line-height: 1.5; text-align: center; letter-spacing: 1rpx; }

.home-nav-mask { position: fixed; top: 0; right: 0; left: 0; z-index: 40; height: calc(96rpx + env(safe-area-inset-top)); background: #F6F4EF; pointer-events: none; }
.logged-in-container { padding-top: calc(116rpx + env(safe-area-inset-top)); }
.home-header { display: flex; margin: 0 4rpx 36rpx; align-items: center; }
.welcome-text { display: block; color: #252824; font-size: 38rpx; font-weight: 700; }
.setup-card { padding: 46rpx 40rpx; border-radius: 36rpx; background: #2D332F; color: #fff; box-shadow: 0 20rpx 55rpx rgba(40,44,41,.16); }
.setup-label { color: #C8D0CA; font-size: 21rpx; letter-spacing: 3rpx; }
.setup-title { display: block; margin-top: 18rpx; font-size: 38rpx; font-weight: 700; }
.setup-desc { display: block; margin-top: 16rpx; color: #D9DED9; font-size: 25rpx; line-height: 1.7; }
.setup-action { display: inline-flex; margin-top: 34rpx; padding: 20rpx 30rpx; border-radius: 18rpx; background: #F5F1E9; color: #2D332F; font-size: 26rpx; font-weight: 650; }

.days-card { padding: 34rpx 32rpx 26rpx; border: 1rpx solid #E3DED4; border-radius: 38rpx; background: linear-gradient(145deg,#FFFFFF 0%,#F1EDE5 100%); box-shadow: 0 18rpx 55rpx rgba(54,49,42,.09); }
.days-card-head, .section-heading { display: flex; align-items: center; justify-content: space-between; }
.days-label { color: #555A54; font-size: 24rpx; font-weight: 600; }
.days-link, .section-link, .section-note { color: var(--text-secondary); font-size: 24rpx; }
.pair-row { display: flex; min-height: 190rpx; align-items: center; justify-content: space-between; }
.avatar { display: flex; width: 112rpx; height: 112rpx; align-items: center; justify-content: center; overflow: hidden; border: 6rpx solid rgba(255,255,255,.92); border-radius: 50%; background: #DDD8CF; box-shadow: 0 8rpx 24rpx rgba(54,49,42,.12); }
.avatar-image { width: 100%; height: 100%; }
.avatar-fallback { color: #757A74; font-size: 30rpx; font-weight: 650; }
.days-center { flex: 1; text-align: center; }
.days-number { color: #B7654D; font-size: 76rpx; font-weight: 720; line-height: 1; }
.days-unit { margin-left: 8rpx; color: #8E776D; font-size: 24rpx; }
.days-date { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 400; }
.days-setup { display: block; color: var(--text-primary); font-size: 29rpx; font-weight: 650; }
.avatar-tip { display: block; color: var(--text-secondary); font-size: 24rpx; text-align: center; }

.quick-section, .album-section { margin-top: 44rpx; }
.section-title { margin: 0; font-size: 30rpx; }
.quick-grid { display: grid; margin-top: 20rpx; grid-template-columns: repeat(2,1fr); gap: 18rpx; }
.quick-item { min-height: 168rpx; padding: 24rpx; border: 1rpx solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,.86); }
.quick-item:active { background: #ECE8DF; }
.quick-icon-img { width: 48rpx; height: 48rpx; margin-bottom: 12rpx; }
.quick-text { display: block; color: #323631; font-size: 28rpx; font-weight: 650; }
.quick-desc { display: block; margin-top: 6rpx; color: var(--text-secondary); font-size: 24rpx; }
.album-grid { display: grid; margin-top: 20rpx; grid-template-columns: repeat(3,1fr); gap: 10rpx; overflow: hidden; border-radius: 28rpx; }
.photo-item { aspect-ratio: 1; overflow: hidden; background: #E4E0D8; }
.photo-img { width: 100%; height: 100%; }
.album-empty { margin-top: 20rpx; padding: 52rpx 30rpx; border: 1rpx dashed #D8D2C7; border-radius: 28rpx; text-align: center; }
.album-empty-title { display: block; color: #555A54; font-size: 27rpx; font-weight: 600; }
.album-empty-desc { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 24rpx; }
.album-empty-action { display: inline-block; margin-top: 20rpx; padding: 14rpx 24rpx; border-radius: var(--radius-sm); background: var(--bg-soft); color: #384037; font-size: 26rpx; }
