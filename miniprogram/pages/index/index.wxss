page { background: #F6F4EF; }
.home-page { padding: 0 32rpx calc(170rpx + env(safe-area-inset-bottom)); }
.login-shell { min-height: 100vh; padding: calc(110rpx + env(safe-area-inset-top)) 24rpx 56rpx; display: flex; flex-direction: column; }
.login-brand { display: flex; flex-direction: column; align-items: flex-start; margin: 0 16rpx 70rpx; }
.brand-mark { display: flex; width: 76rpx; height: 76rpx; margin-bottom: 40rpx; align-items: center; justify-content: center; border-radius: 26rpx; background: #2D332F; color: #fff; font-size: 30rpx; font-weight: 650; }
.login-eyebrow, .home-eyebrow { margin-bottom: 12rpx; color: #8D796E; font-size: 20rpx; font-weight: 650; letter-spacing: 5rpx; }
.login-title { color: #252824; font-size: 54rpx; font-weight: 700; letter-spacing: 1rpx; }
.login-subtitle { margin-top: 16rpx; color: #737871; font-size: 26rpx; line-height: 1.7; }
.login-panel { padding: 38rpx 32rpx 32rpx; border: 1rpx solid #E5E0D6; border-radius: 38rpx; background: rgba(255,255,255,.9); box-shadow: 0 24rpx 70rpx rgba(54,49,42,.08); }
.field { margin-bottom: 26rpx; }
.field-label { display: block; margin: 0 0 12rpx 4rpx; color: #515650; font-size: 24rpx; font-weight: 600; }
.login-input { width: 100%; height: 96rpx; padding: 0 28rpx; border: 1rpx solid #E5E0D6; border-radius: 22rpx; background: #FAF9F6; color: #252824; font-size: 28rpx; }
.input-placeholder { color: #A5A69F; }
.login-btn { width: 100%; height: 96rpx; margin-top: 12rpx; border-radius: 22rpx; background: #2D332F; color: #fff; font-size: 29rpx; font-weight: 650; }
.login-btn:active { opacity: .86; }
.login-hint { display: block; margin-top: 24rpx; color: #92968F; font-size: 22rpx; text-align: center; }
.login-footnote { margin-top: auto; padding-top: 44rpx; color: #A09D95; font-size: 21rpx; text-align: center; letter-spacing: 1rpx; }

.logged-in-container { padding-top: calc(42rpx + env(safe-area-inset-top)); }
.home-header { display: flex; margin: 0 4rpx 36rpx; align-items: center; justify-content: space-between; }
.welcome-text { display: block; color: #252824; font-size: 38rpx; font-weight: 700; }
.profile-entry { padding: 14rpx 22rpx; border: 1rpx solid #DED9D0; border-radius: 999rpx; background: rgba(255,255,255,.65); color: #555A54; font-size: 23rpx; }
.setup-card { padding: 46rpx 40rpx; border-radius: 36rpx; background: #2D332F; color: #fff; box-shadow: 0 20rpx 55rpx rgba(40,44,41,.16); }
.setup-label { color: #C8D0CA; font-size: 21rpx; letter-spacing: 3rpx; }
.setup-title { display: block; margin-top: 18rpx; font-size: 38rpx; font-weight: 700; }
.setup-desc { display: block; margin-top: 16rpx; color: #D9DED9; font-size: 25rpx; line-height: 1.7; }
.setup-action { display: inline-flex; margin-top: 34rpx; padding: 20rpx 30rpx; border-radius: 18rpx; background: #F5F1E9; color: #2D332F; font-size: 26rpx; font-weight: 650; }

.days-card { padding: 34rpx 32rpx 26rpx; border: 1rpx solid #E3DED4; border-radius: 38rpx; background: linear-gradient(145deg,#FFFFFF 0%,#F1EDE5 100%); box-shadow: 0 18rpx 55rpx rgba(54,49,42,.09); }
.days-card-head, .section-heading { display: flex; align-items: center; justify-content: space-between; }
.days-label { color: #555A54; font-size: 24rpx; font-weight: 600; }
.days-link, .section-link, .section-note { color: #96978F; font-size: 22rpx; }
.pair-row { display: flex; min-height: 190rpx; align-items: center; justify-content: space-between; }
.avatar { display: flex; width: 112rpx; height: 112rpx; align-items: center; justify-content: center; overflow: hidden; border: 6rpx solid rgba(255,255,255,.92); border-radius: 50%; background: #DDD8CF; box-shadow: 0 8rpx 24rpx rgba(54,49,42,.12); }
.avatar-image { width: 100%; height: 100%; }
.avatar-fallback { color: #757A74; font-size: 30rpx; font-weight: 650; }
.days-center { flex: 1; text-align: center; }
.days-number { color: #B7654D; font-size: 76rpx; font-weight: 720; line-height: 1; }
.days-unit { margin-left: 8rpx; color: #8E776D; font-size: 24rpx; }
.days-date { display: block; margin-top: 10rpx; color: #888C85; font-size: 21rpx; }
.avatar-tip { display: block; color: #A09F97; font-size: 20rpx; text-align: center; }

.quick-section, .album-section { margin-top: 44rpx; }
.section-title { margin: 0; font-size: 30rpx; }
.quick-grid { display: grid; margin-top: 20rpx; grid-template-columns: repeat(2,1fr); gap: 18rpx; }
.quick-item { min-height: 180rpx; padding: 26rpx; border: 1rpx solid #E5E0D7; border-radius: 28rpx; background: rgba(255,255,255,.86); }
.quick-item:active { background: #ECE8DF; }
.quick-icon-img { width: 48rpx; height: 48rpx; margin-bottom: 18rpx; opacity: .82; }
.quick-text { display: block; color: #323631; font-size: 28rpx; font-weight: 650; }
.quick-desc { display: block; margin-top: 6rpx; color: #90928B; font-size: 21rpx; }
.album-grid { display: grid; margin-top: 20rpx; grid-template-columns: repeat(3,1fr); gap: 10rpx; overflow: hidden; border-radius: 28rpx; }
.photo-item { aspect-ratio: 1; overflow: hidden; background: #E4E0D8; }
.photo-img { width: 100%; height: 100%; }
.album-empty { margin-top: 20rpx; padding: 52rpx 30rpx; border: 1rpx dashed #D8D2C7; border-radius: 28rpx; text-align: center; }
.album-empty-title { display: block; color: #555A54; font-size: 27rpx; font-weight: 600; }
.album-empty-desc { display: block; margin-top: 8rpx; color: #9A9B94; font-size: 22rpx; }

.bottom-nav { position: fixed; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 28rpx; z-index: 30; display: flex; height: 104rpx; padding: 12rpx; align-items: center; border: 1rpx solid rgba(222,217,208,.9); border-radius: 34rpx; background: rgba(255,255,255,.94); box-shadow: 0 16rpx 50rpx rgba(54,49,42,.14); }
.nav-item { display: flex; flex: 1; height: 80rpx; align-items: center; justify-content: center; gap: 12rpx; border-radius: 24rpx; color: #8A8E87; font-size: 23rpx; }
.nav-item.active { background: #ECE8DF; color: #343832; font-weight: 650; }
.nav-icon { width: 34rpx; height: 34rpx; opacity: .72; }
