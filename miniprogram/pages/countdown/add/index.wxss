page { background: #F6F4EF; }
.container { padding: 32rpx; }
.form { padding: 36rpx 30rpx; border: 1rpx solid #E2DED5; border-radius: 34rpx; background: #fff; }
.form-item { margin-bottom: 34rpx; }
.form-label { display: block; margin-bottom: 12rpx; color: #555A54; font-size: 24rpx; font-weight: 600; }
.form-input, .form-picker { width: 100%; height: 94rpx; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; }
.form-input { padding: 0 24rpx; color: #2E322D; font-size: 28rpx; }
.picker-content { display: flex; height: 94rpx; padding: 0 24rpx; align-items: center; justify-content: space-between; }
.picker-text { color: #3C403B; font-size: 28rpx; }
.picker-arrow { color: #999C95; font-size: 34rpx; }
.form-textarea { width: 100%; min-height: 220rpx; padding: 24rpx; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; color: #2E322D; font-size: 28rpx; }
.save-btn { display: flex; width: 100%; height: 94rpx; margin-top: 16rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #2D332F; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 1.4; text-align: center; }
.switch-item { display: flex; padding: 6rpx 0 22rpx; align-items: center; justify-content: space-between; }
.form-label.compact { margin-bottom: 4rpx; }
.form-help { display: block; max-width: 470rpx; color: #969990; font-size: 21rpx; }
.loading-state { position: fixed; inset: 0; z-index: 50; background: rgba(246,244,239,.86); }
