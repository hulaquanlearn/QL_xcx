page { background: #F6F4EF; }
.mine-page { padding: 32rpx 32rpx calc(70rpx + env(safe-area-inset-bottom)); }
.profile-card { overflow: hidden; border: 1rpx solid #E1DDD4; border-radius: 38rpx; background: #fff; box-shadow: 0 16rpx 50rpx rgba(54,49,42,.08); }
.profile-main { display: flex; min-height: 176rpx; padding: 32rpx; align-items: center; }
.profile-avatar, .partner-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #E7E2D8; color: #676C66; font-weight: 650; }
.profile-avatar { width: 104rpx; height: 104rpx; font-size: 34rpx; }
.profile-avatar image, .partner-avatar image { width: 100%; height: 100%; }
.profile-info { flex: 1; margin-left: 24rpx; }
.profile-name { display: block; color: #252824; font-size: 36rpx; font-weight: 700; }
.profile-desc { display: block; margin-top: 6rpx; color: #8B8E87; font-size: 23rpx; }
.edit-text { padding: 12rpx 20rpx; border-radius: 999rpx; background: #F1EEE7; color: #676C66; font-size: 22rpx; }
.partner-row { display: flex; padding: 26rpx 32rpx; align-items: center; border-top: 1rpx solid #EEEAE2; background: #FAF9F6; }
.partner-avatar { width: 72rpx; height: 72rpx; font-size: 23rpx; }
.partner-detail { flex: 1; margin-left: 20rpx; }
.partner-label { display: block; color: #9A9C95; font-size: 20rpx; }
.partner-name { display: block; margin-top: 2rpx; color: #414540; font-size: 27rpx; font-weight: 600; }
.connected-badge { display: flex; align-items: center; gap: 8rpx; color: #69796E; font-size: 21rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #728277; }
.stats-card { display: grid; margin-top: 22rpx; padding: 28rpx 8rpx; grid-template-columns: repeat(3,1fr); border: 1rpx solid #E1DDD4; border-radius: 30rpx; background: #fff; }
.stat-item { text-align: center; border-right: 1rpx solid #EEEAE2; }
.stat-item:last-child { border-right: 0; }
.stat-number { display: block; color: #313530; font-size: 40rpx; font-weight: 700; }
.stat-number.highlight { color: #B7654D; }
.stat-label { display: block; margin-top: 4rpx; color: #93968F; font-size: 22rpx; }
.menu-section { margin-top: 42rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }
.section-note { color: #989A93; font-size: 21rpx; }
.relation-actions { display: grid; grid-template-columns: repeat(2,1fr); gap: 18rpx; }
.relation-card { padding: 28rpx 26rpx; border: 1rpx solid #E2DED5; border-radius: 28rpx; background: #fff; }
.relation-index { display: block; color: #B08B7E; font-size: 18rpx; letter-spacing: 2rpx; }
.relation-title { display: block; margin-top: 24rpx; color: #343833; font-size: 28rpx; font-weight: 650; }
.relation-desc { display: block; margin-top: 6rpx; color: #92958E; font-size: 21rpx; }
.menu-list { overflow: hidden; border: 1rpx solid #E2DED5; border-radius: 28rpx; background: #fff; }
.menu-item { display: flex; min-height: 100rpx; padding: 0 28rpx; align-items: center; border-bottom: 1rpx solid #EEEAE2; }
.menu-item:last-child { border-bottom: 0; }
.menu-text { flex: 1; color: #3E423D; font-size: 27rpx; }
.menu-value { margin-right: 14rpx; color: #999B94; font-size: 22rpx; }
.menu-arrow { color: #B0B1AA; font-size: 36rpx; }
.logout-item .menu-text { color: #A54F47; }
.modal-overlay { position: fixed; inset: 0; z-index: 100; display: flex; padding: 32rpx; align-items: center; justify-content: center; background: rgba(35,38,34,.48); backdrop-filter: blur(8rpx); }
.modal-content { width: 100%; max-width: 620rpx; padding: 42rpx 36rpx 32rpx; border-radius: 38rpx; background: #fff; box-shadow: 0 30rpx 80rpx rgba(20,22,20,.2); }
.modal-kicker { display: block; color: #A27C6E; font-size: 18rpx; font-weight: 650; letter-spacing: 4rpx; }
.modal-title { display: block; margin-top: 10rpx; color: #292D28; font-size: 38rpx; font-weight: 700; }
.modal-desc { display: block; margin-top: 12rpx; color: #8B8E87; font-size: 24rpx; }
.invite-code-box { margin: 34rpx 0; padding: 28rpx; border-radius: 22rpx; background: #F1EEE7; text-align: center; }
.invite-code { color: #343832; font-size: 44rpx; font-weight: 720; letter-spacing: 10rpx; }
.invite-input, .edit-input { width: 100%; height: 94rpx; margin: 30rpx 0 18rpx; padding: 0 24rpx; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; font-size: 28rpx; }
.modal-btn { display: flex; height: 88rpx; margin-top: 14rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #F1EEE7; color: #555A54; font-size: 27rpx; font-weight: 600; line-height: 1.4; text-align: center; }
.modal-btn.primary { background: #2D332F; color: #fff; }
.edit-form { margin-top: 26rpx; }
.edit-item { margin-bottom: 26rpx; }
.edit-label { display: block; color: #626760; font-size: 23rpx; font-weight: 600; }
.edit-input { margin-top: 10rpx; }
.gender-options { display: grid; margin-top: 12rpx; grid-template-columns: repeat(3,1fr); gap: 12rpx; }
.gender-option { padding: 18rpx 8rpx; border: 1rpx solid #DED9D0; border-radius: 16rpx; color: #7A7E77; font-size: 23rpx; text-align: center; }
.gender-option.active { border-color: #78867C; background: #E9EEE9; color: #465048; font-weight: 650; }
