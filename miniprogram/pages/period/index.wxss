.period-page { padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.eyebrow,.title,.subtitle,.card-label,.status-title,.muted,.estimate,.legend,.record-date,.detail,.disclaimer,.field-label { display:block; }
.eyebrow { color:#93796C;font-size:22rpx;letter-spacing:4rpx;margin-top:10rpx; }
.title { font-size:44rpx;font-weight:650;margin:12rpx 0; }
.subtitle,.muted { color:#747872;font-size:24rpx;line-height:1.65; }
.tabs { display:flex;background:#EAE7E0;padding:8rpx;border-radius:22rpx;margin:32rpx 0 24rpx; }
.tab { flex:1;min-height:76rpx;font-size:27rpx;color:#686D66; }
.tab.selected { background:white;color:#302F2C; }
.summary-card,.panel,.record { background:#FFF;border:1rpx solid #E8E3DB;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx; }
.summary-card { background:#F0E9E2; }
.card-label { color:#806B60;font-size:24rpx; }
.status-title { font-size:35rpx;font-weight:600;margin-top:16rpx; }
.stats { display:flex;gap:52rpx;margin:28rpx 0; }
.number { display:block;font-size:46rpx;font-weight:600; }
.estimate { font-size:25rpx;line-height:1.7;color:#645D56; }
.actions { display:flex;gap:16rpx;margin-top:26rpx; }
.primary-button,.soft-button { flex:1;min-height:84rpx;padding:16rpx 20rpx;font-size:27rpx;border-radius:18rpx; }
.primary-button { color:white;background:#3C443D; }
.soft-button { color:#41473F;background:#F8F7F3;border:1rpx solid #E4E0D8; }
button[disabled] { opacity:.55; }
.calendar-head { display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:600; }
.calendar-head button { width:80rpx;height:76rpx;font-size:44rpx; }
.calendar { display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx;margin:18rpx 0; }
.weekday,.day { display:flex;align-items:center;justify-content:center;height:66rpx;font-size:26rpx;border:2rpx solid transparent;border-radius:18rpx; }
.weekday { color:#92968F;font-size:22rpx; }
.day.recorded { background:#E2C9BC;color:#594039; }
.day.predicted { border:2rpx dashed #967565; }
.day.today { text-decoration:underline;text-underline-offset:8rpx;font-weight:700; }
.legend { color:#7C8078;font-size:21rpx;line-height:1.7; }
.privacy-card { display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 4rpx 32rpx; }
.section-name { display:block;font-size:28rpx;font-weight:600; }
.privacy-button { flex-shrink:0;min-height:76rpx;padding:12rpx 18rpx;border:1rpx solid #DAD5CC;font-size:24rpx; }
.history-heading { display:flex;align-items:center;justify-content:space-between;margin:12rpx 0 20rpx; }
.record-date { font-weight:600;font-size:28rpx; }
.record .muted { margin-top:10rpx; }
.detail { font-size:25rpx;margin-top:16rpx;color:#6C6E65; }
.record-actions { display:flex;justify-content:flex-end;gap:16rpx;margin-top:14rpx; }
.record-actions button { min-width:100rpx;min-height:68rpx;font-size:24rpx;color:#816653; }
.disclaimer { color:#85877E;font-size:22rpx;line-height:1.8;padding:12rpx 4rpx 20rpx; }
.state { display:flex;flex-direction:column;gap:24rpx;align-items:center;text-align:center;padding:60rpx 20rpx;color:#767B73; }
.overlay { position:fixed;inset:0;z-index:200;background:rgba(28,32,28,.42);display:flex;align-items:center;justify-content:center;padding:32rpx; }
.editor { width:100%;max-width:680rpx;background:#FFF;border-radius:28rpx;overflow:hidden; }
.editor-head { display:flex;justify-content:space-between;align-items:center;padding:16rpx 28rpx;border-bottom:1rpx solid #E8E3DB; }
.editor-head button { width:70rpx;height:70rpx;font-size:40rpx;color:#777; }
.editor-body { height:56vh;padding:0 28rpx 28rpx;box-sizing:border-box; }
.field-label { margin:26rpx 0 12rpx;font-size:24rpx;color:#777A73; }
.field-value { display:flex;align-items:center;justify-content:space-between;min-height:84rpx;padding:18rpx 22rpx;background:#F7F5F1;border-radius:16rpx;font-size:27rpx; }
.field-value text { color:#8A8D85;font-size:23rpx; }
.switch-row { display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;font-size:27rpx; }
.chips { display:flex;gap:14rpx;flex-wrap:wrap;margin-bottom:20rpx; }
.chip { min-height:72rpx;padding:14rpx 22rpx;background:#F6F4EF;font-size:24rpx;border:1rpx solid transparent; }
.chip.chosen { background:#EEE1D9;border-color:#C5A596;color:#654C41; }
.editor-footer { display:flex;gap:18rpx;padding:24rpx 28rpx; }
