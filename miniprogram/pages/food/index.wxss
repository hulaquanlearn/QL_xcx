page { background: #F6F4EF; }
.food-page { min-height: 100vh; padding: 30rpx 30rpx calc(72rpx + env(safe-area-inset-bottom)); }
.food-page.with-tray { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }
.page-intro, .manager-head { display: flex; align-items: flex-start; justify-content: space-between; }
.eyebrow { display: block; margin-bottom: 10rpx; color: #9B786B; font-size: 19rpx; font-weight: 650; letter-spacing: 4rpx; }
.page-title { display: block; color: #282C28; font-size: 46rpx; font-weight: 720; line-height: 1.2; }
.page-subtitle { display: block; margin-top: 10rpx; color: #8A8E87; font-size: 23rpx; line-height: 1.55; }
.manage-entry, .back-action { display: flex; min-height: 62rpx; padding: 0 22rpx; align-items: center; justify-content: center; border: 1rpx solid #DFDAD0; border-radius: 999rpx; background: rgba(255,255,255,.82); color: #5F655F; font-size: 22rpx; font-weight: 600; }
.header-actions { display: flex; flex-shrink: 0; gap: 10rpx; }
.planner-entry { display: flex; min-height: 62rpx; padding: 0 20rpx; align-items: center; border-radius: 999rpx; background: #E7EEE8; color: #526158; font-size: 22rpx; font-weight: 650; }
.view-switch { display: flex; height: 82rpx; margin-top: 34rpx; padding: 7rpx; align-items: center; border: 1rpx solid #E0DBD2; border-radius: 24rpx; background: #ECE8DF; }
.view-switch-item { display: flex; flex: 1; height: 66rpx; align-items: center; justify-content: center; gap: 10rpx; border-radius: 18rpx; color: #83877F; font-size: 25rpx; font-weight: 600; }
.view-switch-item.active { background: #FFFFFF; color: #303530; box-shadow: 0 6rpx 18rpx rgba(54,49,42,.08); }
.switch-count { display: flex; min-width: 34rpx; height: 34rpx; padding: 0 9rpx; align-items: center; justify-content: center; border-radius: 999rpx; background: #EAE5DB; color: #777C75; font-size: 18rpx; }
.meal-scroll { width: calc(100% + 30rpx); margin: 30rpx -30rpx 0 0; white-space: nowrap; }
.meal-row, .menu-row { display: inline-flex; min-width: 100%; padding-right: 30rpx; gap: 14rpx; }
.meal-chip { display: flex; min-width: 126rpx; height: 66rpx; padding: 0 26rpx; align-items: center; justify-content: center; border: 1rpx solid #E1DDD4; border-radius: 999rpx; background: #FFFFFF; color: #767B74; font-size: 23rpx; }
.meal-chip.active { border-color: #2E3530; background: #2E3530; color: #FFFFFF; font-weight: 650; }
.menu-scroll { width: calc(100% + 30rpx); margin: 24rpx -30rpx 0 0; white-space: nowrap; }
.menu-filter { display: inline-flex; height: 58rpx; padding: 0 4rpx; align-items: center; border-bottom: 3rpx solid transparent; color: #969990; font-size: 23rpx; }
.menu-filter.active { border-color: #B7654D; color: #353A35; font-weight: 650; }
.menu-groups { margin-top: 30rpx; }
.menu-group { margin-bottom: 40rpx; }
.group-head { display: flex; margin-bottom: 18rpx; align-items: center; justify-content: space-between; }
.group-title { color: #303530; font-size: 30rpx; font-weight: 680; }
.group-count { color: #9B9D96; font-size: 21rpx; }
.dish-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18rpx; }
.dish-card { position: relative; overflow: hidden; border: 2rpx solid #E3DED5; border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 10rpx 28rpx rgba(54,49,42,.06); }
.dish-card.selected { border-color: #66776C; box-shadow: 0 12rpx 34rpx rgba(72,89,78,.14); }
.dish-cover { width: 100%; height: 220rpx; background: #E4DED4; }
.dish-placeholder { display: flex; align-items: flex-end; padding: 20rpx; background: linear-gradient(145deg,#DDD6CB 0%,#BFC8BF 100%); color: rgba(255,255,255,.9); font-size: 20rpx; letter-spacing: 2rpx; }
.dish-card-body { padding: 20rpx 20rpx 22rpx; }
.dish-title { display: block; overflow: hidden; color: #333833; font-size: 27rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.dish-menu-name { display: block; margin-top: 5rpx; overflow: hidden; color: #9A9C95; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.select-mark { position: absolute; top: 16rpx; right: 16rpx; display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.85); border-radius: 50%; background: rgba(39,46,41,.82); color: #FFFFFF; font-size: 30rpx; font-weight: 600; line-height: 1; }
.group-empty { padding: 34rpx; border: 1rpx dashed #DAD5CB; border-radius: 24rpx; color: #999B94; font-size: 22rpx; text-align: center; }
.empty-state { display: flex; min-height: 520rpx; padding: 80rpx 42rpx; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-title { color: #3D423D; font-size: 31rpx; font-weight: 680; }
.empty-desc { max-width: 470rpx; margin-top: 12rpx; color: #92958E; font-size: 23rpx; line-height: 1.7; }
.empty-action { display: flex; min-height: 76rpx; margin-top: 30rpx; padding: 0 28rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #2D332F; color: #FFFFFF; font-size: 24rpx; font-weight: 650; }
.orders-list { margin-top: 30rpx; }
.order-card { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #E1DDD4; border-radius: 30rpx; background: #FFFFFF; box-shadow: 0 10rpx 30rpx rgba(54,49,42,.05); }
.order-head, .order-foot, .manager-card-head, .modal-head { display: flex; align-items: center; justify-content: space-between; }
.order-meal { display: block; color: #363B36; font-size: 29rpx; font-weight: 680; }
.order-time { display: block; margin-top: 4rpx; color: #A0A19A; font-size: 20rpx; }
.order-status { padding: 10rpx 16rpx; border-radius: 999rpx; background: #F0E7E1; color: #A05F4B; font-size: 19rpx; }
.order-status.accepted { background: #E8EEE9; color: #5D7464; }
.order-status.ready { background: #F4EBDD; color: #95663F; }
.order-status.completed { background: #E7ECE7; color: #52635A; }
.order-menu { display: block; margin-top: 24rpx; color: #858981; font-size: 21rpx; }
.order-dishes { display: flex; margin-top: 15rpx; flex-wrap: wrap; gap: 12rpx; }
.order-dish { display: flex; min-height: 58rpx; padding: 7rpx 18rpx 7rpx 8rpx; align-items: center; gap: 12rpx; border-radius: 999rpx; background: #F3F0EA; color: #555A54; font-size: 22rpx; }
.order-dish-image { width: 44rpx; height: 44rpx; border-radius: 50%; background: #D8D3CA; }
.order-dish-placeholder { background: #C9D0C9; }
.order-foot { margin-top: 26rpx; padding-top: 20rpx; border-top: 1rpx solid #EEEAE2; }
.order-by { color: #94978F; font-size: 21rpx; }
.order-progress { display: block; margin-top: 5rpx; color: #6E796F; font-size: 19rpx; }
.order-actions { display: flex; max-width: 65%; flex-wrap: wrap; justify-content: flex-end; gap: 12rpx; }
.order-action { display: flex; min-height: 58rpx; padding: 0 22rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #F0EDE7; color: #6E736C; font-size: 21rpx; font-weight: 600; }
.order-action.primary { background: #2D332F; color: #FFFFFF; }
.manager-head { flex-direction: column; align-items: flex-start; }
.manager-head .back-action { margin-bottom: 30rpx; }
.manager-card { margin-top: 26rpx; padding: 30rpx; border: 1rpx solid #E1DDD4; border-radius: 30rpx; background: #FFFFFF; }
.manager-label { display: block; color: #3E433E; font-size: 27rpx; font-weight: 650; }
.manager-helper { display: block; margin-top: 4rpx; color: #999B94; font-size: 20rpx; }
.manager-actions { display: flex; align-items: center; gap: 12rpx; }
.batch-menu-action { display: flex; min-height: 62rpx; padding: 0 18rpx; align-items: center; border: 1rpx solid #DED9D0; border-radius: 18rpx; color: #6E736C; font-size: 21rpx; font-weight: 600; }
.new-menu-action { display: flex; min-height: 62rpx; padding: 0 22rpx; align-items: center; border-radius: 18rpx; background: #E9EEE9; color: #536458; font-size: 22rpx; font-weight: 650; }
.select-field, .manager-input { display: flex; width: 100%; height: 90rpx; margin-top: 24rpx; padding: 0 24rpx; align-items: center; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; color: #414640; font-size: 26rpx; line-height: 90rpx; }
.select-field { justify-content: space-between; }
.select-field.disabled { color: #A2A39D; }
.field-arrow { color: #9A9D96; font-size: 36rpx; }
.field-title { margin-top: 34rpx; }
.dish-input-row { display: flex; align-items: flex-end; gap: 14rpx; }
.dish-input { flex: 1; min-width: 0; }
.add-dish-action { display: flex; width: 116rpx; height: 90rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #2D332F; color: #FFFFFF; font-size: 23rpx; font-weight: 650; }
.editing-dishes { margin-top: 26rpx; }
.editing-dish { display: flex; min-height: 94rpx; padding: 14rpx 0; align-items: center; border-bottom: 1rpx solid #EEEAE2; }
.editing-cover { position: relative; display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 16rpx; background: #E9E5DD; color: #8B8F88; font-size: 19rpx; }
.editing-cover image { width: 100%; height: 100%; }
.image-upload-state { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(38,43,39,.68); color: #FFFFFF; font-size: 16rpx; }
.editing-name { flex: 1; margin-left: 18rpx; color: #4A4F49; font-size: 25rpx; }
.editing-dish-actions { display: flex; align-items: center; gap: 4rpx; }
.recipe-dish-action { padding: 14rpx; color: #66756B; font-size: 21rpx; }
.recipe-dish-action.ready { color: #A06048; }
.remove-dish { padding: 14rpx; color: #AD6056; font-size: 21rpx; }
.editor-empty { margin-top: 26rpx; padding: 34rpx; border: 1rpx dashed #D9D4CA; border-radius: 20rpx; color: #9B9D96; font-size: 21rpx; text-align: center; }
.save-menu { display: flex; width: 100%; height: 92rpx; margin-top: 30rpx; align-items: center; justify-content: center; border-radius: 21rpx; background: #2D332F; color: #FFFFFF; font-size: 27rpx; font-weight: 650; line-height: 1.2; }
.save-menu.disabled { background: #8B918C; }
.save-menu::after { border: 0; }
.delete-menu { margin-top: 24rpx; color: #A65A51; font-size: 22rpx; text-align: center; }
.selection-tray { position: fixed; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 40; display: flex; min-height: 116rpx; padding: 14rpx 14rpx 14rpx 26rpx; align-items: center; gap: 20rpx; border: 1rpx solid rgba(221,216,207,.9); border-radius: 30rpx; background: rgba(255,255,255,.96); box-shadow: 0 20rpx 58rpx rgba(44,48,44,.18); }
.tray-copy { flex: 1; min-width: 0; }
.tray-count { display: block; color: #373C37; font-size: 25rpx; font-weight: 680; }
.tray-summary { display: block; margin-top: 3rpx; overflow: hidden; color: #969890; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.tray-action { display: flex; width: 184rpx; height: 84rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #2D332F; color: #FFFFFF; font-size: 25rpx; font-weight: 650; line-height: 1.2; }
.tray-action::after { border: 0; }
.modal-overlay { position: fixed; inset: 0; z-index: 100; display: flex; padding: 32rpx; align-items: center; justify-content: center; background: rgba(32,36,32,.5); }
.create-modal { width: 100%; max-width: 620rpx; padding: 36rpx 32rpx 30rpx; border-radius: 34rpx; background: #FFFFFF; box-shadow: 0 30rpx 80rpx rgba(20,23,20,.24); }
.batch-modal { max-height: 86vh; overflow-y: auto; box-sizing: border-box; }
.modal-title { color: #2F342F; font-size: 36rpx; font-weight: 700; }
.modal-close { padding: 10rpx; color: #959891; font-size: 22rpx; }
.modal-desc { display: block; margin-top: 8rpx; color: #93968F; font-size: 22rpx; }
.modal-input { display: block; width: 100%; height: 94rpx; margin-top: 28rpx; padding: 0 24rpx; border: 1rpx solid #DCD7CE; border-radius: 20rpx; background: #FAF9F6; color: #333833; font-size: 27rpx; line-height: 94rpx; }
.batch-example { display: block; margin-top: 12rpx; color: #8A766D; font-size: 20rpx; line-height: 1.5; }
.batch-meal-row { display: flex; margin-top: 22rpx; gap: 10rpx; }
.batch-meal-chip { display: flex; flex: 1; height: 58rpx; align-items: center; justify-content: center; border: 1rpx solid #DED9D0; border-radius: 16rpx; color: #7B8079; font-size: 20rpx; }
.batch-meal-chip.active { border-color: #4F5D54; background: #E9EEE9; color: #435047; font-weight: 650; }
.family-preset-card { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #DADFD9; border-radius: 22rpx; background: #F3F6F2; }
.family-preset-copy { min-width: 0; }
.family-preset-title { display: block; color: #3C493F; font-size: 26rpx; font-weight: 680; }
.family-preset-desc { display: block; margin-top: 5rpx; color: #7F8981; font-size: 19rpx; line-height: 1.5; }
.family-preset-action { display: flex; height: 70rpx; margin-top: 17rpx; align-items: center; justify-content: center; border-radius: 17rpx; background: #53645A; color: #FFFFFF; font-size: 22rpx; font-weight: 650; }
.family-preset-action.disabled { background: #929A94; }
.batch-divider { display: flex; margin-top: 24rpx; align-items: center; gap: 14rpx; color: #A0A29C; font-size: 19rpx; }
.batch-divider::before, .batch-divider::after { height: 1rpx; flex: 1; background: #E4E0D8; content: ''; }
.batch-textarea { display: block; width: 100%; height: 300rpx; margin-top: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid #DCD7CE; border-radius: 20rpx; background: #FAF9F6; color: #333833; font-size: 24rpx; line-height: 1.65; box-sizing: border-box; }
.field-placeholder { color: #AAA9A3; }
.modal-actions { display: grid; margin-top: 30rpx; grid-template-columns: 1fr 1.3fr; gap: 14rpx; }
.modal-action { display: flex; height: 84rpx; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 25rpx; font-weight: 650; }
.modal-action.secondary { background: #F0EDE7; color: #676C66; }
.modal-action.primary { background: #2D332F; color: #FFFFFF; }
.modal-action.disabled { background: #8F958F; }
.recipe-overlay { align-items: flex-end; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); }
.recipe-modal { max-height: 88vh; overflow-y: auto; box-sizing: border-box; }
.recipe-modal-subtitle { display: block; margin-top: 4rpx; color: #999C95; font-size: 20rpx; }
.recipe-image-editor { position: relative; display: flex; width: 100%; height: 270rpx; margin-top: 26rpx; align-items: center; justify-content: center; overflow: hidden; border: 1rpx dashed #D6D1C7; border-radius: 24rpx; background: #F4F1EB; }
.recipe-image-editor image { width: 100%; height: 100%; }
.recipe-image-empty { display: flex; flex-direction: column; align-items: center; color: #606860; font-size: 25rpx; font-weight: 650; }
.recipe-image-helper { margin-top: 8rpx; color: #999C95; font-size: 19rpx; font-weight: 400; }
.clear-recipe-image { margin-top: 12rpx; color: #A45D52; font-size: 21rpx; text-align: right; }
.recipe-field-label { display: block; margin-top: 26rpx; color: #424842; font-size: 24rpx; font-weight: 650; }
.recipe-textarea { display: block; width: 100%; height: 180rpx; margin-top: 12rpx; padding: 20rpx 22rpx; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; color: #3E433E; font-size: 23rpx; line-height: 1.7; box-sizing: border-box; }
.recipe-textarea.steps { height: 240rpx; }
.recipe-textarea.tips { height: 150rpx; }
.recipe-actions { position: sticky; bottom: -30rpx; z-index: 2; margin: 28rpx -32rpx -30rpx; padding: 20rpx 32rpx 30rpx; background: #FFFFFF; }
