<wxs module="dishUtil">
  function isSelected(selectedDishes, menuId, dishId) {
    for (var i = 0; i < selectedDishes.length; i++) {
      var selectedId = selectedDishes[i].id || selectedDishes[i].name;
      if (selectedDishes[i].menuId == menuId && selectedId == dishId) return true;
    }
    return false;
  }
  module.exports = { isSelected: isSelected };
</wxs>

<view class="food-page {{selectedDishes.length > 0 && activeTab === 'order' ? 'with-tray' : ''}}">
  <view wx:if="{{activeTab !== 'manage'}}" class="page-intro">
    <view>
      <text class="eyebrow">TODAY'S TABLE</text>
      <text class="page-title">今天吃什么</text>
      <text class="page-subtitle">选几道想吃的，发给对方就好</text>
    </view>
    <view class="header-actions">
      <view class="planner-entry" bindtap="openPlanner">周菜单</view>
      <view class="manage-entry" bindtap="openMenuManager">管理</view>
    </view>
  </view>

  <view wx:if="{{activeTab !== 'manage'}}" class="view-switch">
    <view class="view-switch-item {{activeTab === 'order' ? 'active' : ''}}" bindtap="switchTab" data-tab="order">点菜</view>
    <view class="view-switch-item {{activeTab === 'orders' ? 'active' : ''}}" bindtap="switchTab" data-tab="orders">
      <text>订单</text>
    </view>
  </view>

  <block wx:if="{{activeTab === 'order'}}">
    <scroll-view class="meal-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
      <view class="meal-row">
        <view wx:for="{{mealTypes}}" wx:key="value" class="meal-chip {{mealType === item.value ? 'active' : ''}}" bindtap="selectMealType" data-type="{{item.value}}">{{item.label}}</view>
      </view>
    </scroll-view>

    <scroll-view wx:if="{{menus.length}}" class="menu-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
      <view class="menu-row">
        <view class="menu-filter {{activeMenuId === 'all' ? 'active' : ''}}" bindtap="selectMenuFilter" data-id="all">全部</view>
        <view wx:for="{{menus}}" wx:key="_id" class="menu-filter {{activeMenuId === item._id ? 'active' : ''}}" bindtap="selectMenuFilter" data-id="{{item._id}}">{{item.name}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{menus.length}}" class="menu-groups">
      <block wx:for="{{menus}}" wx:key="_id" wx:for-item="menu">
        <view wx:if="{{activeMenuId === 'all' || activeMenuId === menu._id}}" class="menu-group">
          <view class="group-head">
            <text class="group-title">{{menu.name}}</text>
            <text class="group-count">{{menu.dishes.length}} 道</text>
          </view>
          <view wx:if="{{menu.dishes.length}}" class="dish-grid">
            <view wx:for="{{menu.dishes}}" wx:key="id" wx:for-item="dish" class="dish-card {{dishUtil.isSelected(selectedDishes, menu._id, dish.id || dish.name) ? 'selected' : ''}}" bindtap="toggleDish" data-dish="{{dish}}" data-menuid="{{menu._id}}" data-menuname="{{menu.name}}">
              <image wx:if="{{dish.image}}" class="dish-cover" src="{{dish.image}}" mode="aspectFill"></image>
              <view wx:else class="dish-cover dish-placeholder"><text>今日菜品</text></view>
              <view class="dish-card-body">
                <text class="dish-title">{{dish.name}}</text>
                <text class="dish-menu-name">{{menu.name}}</text>
              </view>
              <view class="select-mark">{{dishUtil.isSelected(selectedDishes, menu._id, dish.id || dish.name) ? '✓' : '+'}}</view>
            </view>
          </view>
          <view wx:else class="group-empty">这个菜单还没有菜品</view>
        </view>
      </block>
    </view>

    <view wx:elif="{{menusLoading}}" class="list-feedback">正在加载菜单…</view>
    <view wx:else class="empty-state menu-empty">
      <text class="empty-title">还没有可点的菜单</text>
      <text class="empty-desc">先建一个常吃菜单，把喜欢的菜放进去。</text>
      <view class="empty-action" bindtap="openMenuManager">创建第一个菜单</view>
    </view>
  </block>

  <block wx:elif="{{activeTab === 'orders'}}">
    <scroll-view class="order-filter-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="order-filter-row"><button wx:for="{{orderStatuses}}" wx:key="value" class="order-filter {{orderStatus === item.value ? 'active' : ''}}" bindtap="selectOrderStatus" data-status="{{item.value}}">{{item.label}}</button></view>
    </scroll-view>
    <view wx:if="{{orders.length}}" class="orders-list">
      <view wx:for="{{orders}}" wx:key="_id" class="order-card">
        <view class="order-head">
          <view>
            <text class="order-meal">{{item.mealType === 'breakfast' ? '早餐' : item.mealType === 'dinner' ? '晚餐' : item.mealType === 'snack' ? '零食' : '午餐'}}</text>
            <text class="order-time">{{item.formattedTime}}</text>
          </view>
          <text class="order-status {{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="order-menu">{{item.menuName}}</text>
        <view class="order-dishes">
          <view wx:for="{{item.dishes}}" wx:key="id" wx:for-item="dish" class="order-dish">
            <image wx:if="{{dish.image}}" class="order-dish-image" src="{{dish.image}}" mode="aspectFill"></image>
            <view wx:else class="order-dish-image order-dish-placeholder"></view>
            <text>{{dish.name}}</text>
          </view>
        </view>
        <text class="order-next-action">{{item.nextActionText}}</text>
        <view class="order-foot">
          <view>
            <text class="order-by">{{item.orderBy || item.author || '我'}} 发起</text>
            <text wx:if="{{item.status !== 'pending'}}" class="order-progress">{{item.acceptedBy || 'TA'}} {{item.status === 'completed' ? '已完成' : item.status === 'ready' ? '已做好' : '已接单'}}</text>
          </view>
          <view class="order-actions">
            <button wx:if="{{item.status === 'pending' && !item.isMine}}" class="order-action primary" bindtap="acceptOrder" data-id="{{item._id}}">接单</button>
            <button wx:if="{{item.status !== 'pending'}}" class="order-action" bindtap="openOrderDetail" data-id="{{item._id}}">制作说明</button>
            <button wx:if="{{item.status === 'accepted' && item.isAcceptedByMe}}" class="order-action primary" bindtap="markOrderReady" data-id="{{item._id}}">已做好</button>
            <button wx:if="{{item.status === 'ready' && item.isMine}}" class="order-action primary" bindtap="confirmOrder" data-id="{{item._id}}">收到啦</button>
            <button wx:if="{{item.isMine && (item.status === 'pending' || item.status === 'completed')}}" class="order-action" bindtap="deleteOrder" data-id="{{item._id}}">{{item.status === 'pending' ? '撤回' : '删除记录'}}</button>
          </view>
        </view>
      </view>
    </view>
    <view wx:elif="{{!ordersLoading && !ordersError}}" class="empty-state order-empty">
      <text class="empty-title">{{orderStatus === 'all' ? '还没有点单' : '这个状态下还没有订单'}}</text>
      <text class="empty-desc">{{orderStatus === 'all' ? '选好今天想吃的，再发给对方。' : '可以切换上方状态查看其他订单。'}}</text>
      <view class="empty-action" bindtap="switchTab" data-tab="order">去点菜</view>
    </view>
    <view wx:if="{{ordersLoading}}" class="list-feedback">正在加载订单…</view>
    <button wx:elif="{{ordersError}}" class="list-load-more" bindtap="retryOrders">{{ordersError}} · 点此重试</button>
    <button wx:elif="{{ordersHasMore && orders.length}}" class="list-load-more" bindtap="loadMoreOrders">查看更多订单</button>
    <view wx:elif="{{orders.length}}" class="list-feedback">已显示全部订单</view>
  </block>

  <block wx:else>
    <view class="manager-head">
      <view class="back-action" bindtap="leaveMenuManager">返回点菜</view>
      <view>
        <text class="eyebrow">MENU LIBRARY</text>
        <text class="page-title">管理菜单</text>
        <text class="page-subtitle">日常点菜用，保持简单就好</text>
      </view>
    </view>

    <view class="manager-card">
      <view class="manager-card-head">
        <view><text class="manager-label">当前菜单</text><text class="manager-helper">选择已有菜单，或新建一个</text></view>
        <view class="manager-actions">
          <view class="batch-menu-action" bindtap="showBatchImportModal">批量导入</view>
          <view class="new-menu-action" bindtap="showCreateMenuModal">新建</view>
        </view>
      </view>
      <picker wx:if="{{menus.length}}" bindchange="selectExistingMenu" value="{{menuIndex}}" range="{{menus}}" range-key="name">
        <view class="select-field">
          <text>{{editingMenu ? editingMenu.name : '选择要编辑的菜单'}}</text>
          <text class="field-arrow">›</text>
        </view>
      </picker>
      <view wx:else class="select-field disabled">还没有菜单</view>
    </view>

    <view wx:if="{{menuName}}" class="manager-card editor-card">
      <text class="manager-label">菜单名称</text>
      <input class="manager-input" value="{{menuName}}" bindinput="onMenuNameInput" maxlength="20" placeholder="例如：家常菜" placeholder-class="field-placeholder"/>
      <text class="manager-label field-title">添加菜品</text>
      <view class="dish-input-row">
        <input class="manager-input dish-input" value="{{newDishName}}" bindinput="onNewDishNameInput" bindconfirm="addDish" confirm-type="done" maxlength="24" placeholder="输入菜品名称" placeholder-class="field-placeholder"/>
        <view class="add-dish-action" bindtap="addDish">添加</view>
      </view>

      <view wx:if="{{dishes.length}}" class="editing-dishes">
        <view wx:for="{{dishes}}" wx:key="id" class="editing-dish">
          <view class="editing-cover" bindtap="chooseDishImage" data-index="{{index}}">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <text wx:else>加图</text>
            <view wx:if="{{item.imageUploading}}" class="image-upload-state">{{item.imageUploadStatus === 'moderating' ? '审核中' : '上传中'}}</view>
          </view>
          <view class="editing-name"><text>{{item.name}}</text><text wx:if="{{item.imageUploadError}}" class="upload-error-copy">{{item.imageUploadError}}</text><button wx:if="{{item.imageUploadRetryPath && !item.imageUploading}}" class="upload-retry-action" bindtap="retryDishUpload" data-index="{{index}}">{{item.imageUploadCheckId ? '继续查询审核' : '重试这张图片'}}</button></view>
          <view class="editing-dish-actions">
            <view class="recipe-dish-action {{item.recipeImageKey || item.ingredients || item.steps || item.tips ? 'ready' : ''}}" bindtap="openRecipeEditor" data-index="{{index}}">{{item.recipeImageKey || item.ingredients || item.steps || item.tips ? '已加做法' : '加做法'}}</view>
            <view class="remove-dish" bindtap="removeDish" data-index="{{index}}">删除</view>
          </view>
        </view>
      </view>
      <view wx:else class="editor-empty">添加菜品后就可以保存菜单</view>

      <button class="save-menu {{uploading ? 'disabled' : ''}}" bindtap="uploadMenu">{{uploading ? '图片上传中' : editingMenu ? '保存修改' : '创建菜单'}}</button>
      <view wx:if="{{editingMenu}}" class="delete-menu" bindtap="deleteMenu">删除当前菜单</view>
    </view>
  </block>
</view>

<view wx:if="{{showRecipeModal}}" class="modal-overlay recipe-overlay" bindtap="closeRecipeEditor">
  <view class="create-modal recipe-modal" catchtap="preventBubble">
    <view class="modal-head">
      <view><text class="modal-title">{{recipeDraft.name}}</text><text class="recipe-modal-subtitle">制作说明</text></view>
      <view class="modal-close" bindtap="closeRecipeEditor">{{recipeUploading ? (recipeUploadStatus === 'moderating' ? '审核中' : '上传中') : '关闭'}}</view>
    </view>

    <view class="recipe-image-editor" bindtap="chooseRecipeImage">
      <image wx:if="{{recipeDraft.recipeImage}}" src="{{recipeDraft.recipeImage}}" mode="aspectFill"></image>
      <view wx:else class="recipe-image-empty"><text>添加制作说明图</text><text class="recipe-image-helper">长图也可以，将自动压缩并安全审核</text></view>
      <view wx:if="{{recipeUploading}}" class="image-upload-state">{{recipeUploadStatus === 'moderating' ? '审核中，请稍候' : '上传中'}}</view>
    </view>
    <text wx:if="{{recipeUploadError}}" class="upload-error-copy">{{recipeUploadError}}</text>
    <button wx:if="{{recipeUploadRetryPath && !recipeUploading}}" class="upload-retry-action" bindtap="retryRecipeUpload">{{recipeUploadCheckId ? '继续查询审核' : '重试说明图'}}</button>
    <view wx:if="{{recipeDraft.recipeImage}}" class="clear-recipe-image" bindtap="clearRecipeImage">移除说明图</view>

    <text class="recipe-field-label">食材与用量</text>
    <textarea class="recipe-textarea ingredients" value="{{recipeDraft.ingredients}}" bindinput="onRecipeInput" data-field="ingredients" maxlength="1200" cursor-spacing="24" placeholder="例如：米饭 1 碗&#10;鸡蛋 2 个&#10;番茄 2 个" placeholder-class="field-placeholder"></textarea>

    <text class="recipe-field-label">制作步骤</text>
    <textarea class="recipe-textarea steps" value="{{recipeDraft.steps}}" bindinput="onRecipeInput" data-field="steps" maxlength="4000" cursor-spacing="24" placeholder="1. 处理食材&#10;2. 下锅翻炒&#10;3. 调味出锅" placeholder-class="field-placeholder"></textarea>

    <text class="recipe-field-label">小贴士</text>
    <textarea class="recipe-textarea tips" value="{{recipeDraft.tips}}" bindinput="onRecipeInput" data-field="tips" maxlength="1000" cursor-spacing="24" placeholder="可选：口味、火候或替换食材" placeholder-class="field-placeholder"></textarea>

    <view class="modal-actions recipe-actions">
      <view class="modal-action secondary" bindtap="closeRecipeEditor">取消</view>
      <view class="modal-action primary {{recipeUploading ? 'disabled' : ''}}" bindtap="saveRecipeEditor">{{recipeUploading ? '说明图上传中' : '保存做法'}}</view>
    </view>
  </view>
</view>

<view wx:if="{{selectedDishes.length > 0 && activeTab === 'order'}}" class="selection-tray">
  <view class="tray-copy">
    <text class="tray-count">已选 {{selectedDishes.length}} 道</text>
    <text class="tray-summary">{{selectedSummary}}</text>
  </view>
  <button class="tray-action" bindtap="submitOrder">发给 TA</button>
</view>

<view wx:if="{{showBatchModal}}" class="modal-overlay" bindtap="closeBatchImportModal">
  <view class="create-modal batch-modal" catchtap="preventBubble">
    <view class="modal-head"><text class="modal-title">批量导入菜单</text><view class="modal-close" bindtap="closeBatchImportModal">关闭</view></view>
    <text class="modal-desc">每行一个菜单，格式：菜单名：菜品1、菜品2</text>
    <text class="batch-example">例如：家常菜：番茄炒蛋、红烧肉、炒青菜</text>
    <view class="batch-meal-row">
      <view wx:for="{{mealTypes}}" wx:key="value" class="batch-meal-chip {{mealType === item.value ? 'active' : ''}}" bindtap="selectMealType" data-type="{{item.value}}">{{item.label}}</view>
    </view>
    <view class="family-preset-card">
      <view class="family-preset-copy">
        <text class="family-preset-title">{{familyMenuPreset.name}}</text>
        <text class="family-preset-desc">8 道家常菜 · 导入后可为菜品添加服务器图片</text>
      </view>
      <view class="family-preset-action {{importingMenus ? 'disabled' : ''}}" bindtap="importFamilyMenuPreset">{{importingMenus ? '正在导入' : '一键导入菜单'}}</view>
    </view>
    <view class="batch-divider"><text>或粘贴自己的菜单</text></view>
    <textarea class="batch-textarea" value="{{batchMenuText}}" bindinput="onBatchMenuInput" maxlength="4000" cursor-spacing="24" placeholder="家常菜：番茄炒蛋、红烧肉&#10;早餐：豆浆、油条" placeholder-class="field-placeholder"></textarea>
    <view class="modal-actions">
      <view class="modal-action secondary" bindtap="closeBatchImportModal">取消</view>
      <view class="modal-action primary" bindtap="importMenus">{{importingMenus ? '导入中' : '开始导入'}}</view>
    </view>
  </view>
</view>

<view wx:if="{{showMenuModal}}" class="modal-overlay" bindtap="closeMenuModal">
  <view class="create-modal" catchtap="preventBubble">
    <view class="modal-head"><text class="modal-title">新建菜单</text><view class="modal-close" bindtap="closeMenuModal">关闭</view></view>
    <text class="modal-desc">取一个容易辨认的名字</text>
    <input class="modal-input" value="{{modalMenuName}}" bindinput="onModalMenuNameInput" bindconfirm="confirmCreateMenu" confirm-type="done" maxlength="20" focus="{{showMenuModal}}" cursor-spacing="24" placeholder="例如：周末菜单" placeholder-class="field-placeholder"/>
    <view class="modal-actions">
      <view class="modal-action secondary" bindtap="closeMenuModal">取消</view>
      <view class="modal-action primary" bindtap="confirmCreateMenu">下一步</view>
    </view>
  </view>
</view>
