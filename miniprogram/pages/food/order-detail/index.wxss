page { background: #F6F4EF; }
.order-detail-page { min-height: 100vh; padding: 30rpx 30rpx 0; color: #303530; box-sizing: border-box; }
.loading-state { display: flex; min-height: 70vh; align-items: center; justify-content: center; color: #92968F; font-size: 24rpx; }
.detail-hero { padding: 8rpx 4rpx 0; }
.detail-eyebrow { display: block; margin-bottom: 10rpx; color: #9B786B; font-size: 19rpx; font-weight: 650; letter-spacing: 4rpx; }
.detail-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.detail-title { display: block; color: #292E29; font-size: 43rpx; font-weight: 720; line-height: 1.25; }
.detail-meta { display: block; margin-top: 9rpx; color: #969991; font-size: 22rpx; }
.detail-status { flex: none; padding: 10rpx 17rpx; border-radius: 999rpx; background: #F0E7E1; color: #A05F4B; font-size: 19rpx; }
.detail-status.accepted { background: #E8EEE9; color: #5D7464; }
.detail-status.ready { background: #F4EBDD; color: #95663F; }
.detail-status.completed { background: #E7ECE7; color: #52635A; }
.progress-card { position: relative; display: flex; margin-top: 30rpx; padding: 26rpx 20rpx 22rpx; justify-content: space-between; border: 1rpx solid #E1DDD4; border-radius: 25rpx; background: #FFFFFF; }
.progress-line { position: absolute; top: 35rpx; right: 72rpx; left: 72rpx; height: 2rpx; background: #E1DDD4; }
.progress-item { position: relative; z-index: 1; display: flex; width: 25%; flex-direction: column; align-items: center; gap: 10rpx; color: #A0A29B; font-size: 18rpx; }
.progress-dot { width: 18rpx; height: 18rpx; border: 6rpx solid #FFFFFF; border-radius: 50%; background: #D9D5CD; box-shadow: 0 0 0 2rpx #D9D5CD; }
.progress-item.active { color: #56645B; font-weight: 650; }
.progress-item.active .progress-dot { background: #5C6C62; box-shadow: 0 0 0 2rpx #5C6C62; }
.dish-tabs { width: calc(100% + 30rpx); margin: 28rpx -30rpx 0 0; white-space: nowrap; }
.dish-tab-row { display: inline-flex; padding-right: 30rpx; gap: 12rpx; }
.dish-tab { display: flex; height: 62rpx; padding: 0 25rpx; align-items: center; border: 1rpx solid #DFDAD1; border-radius: 999rpx; background: #FFFFFF; color: #777C75; font-size: 22rpx; }
.dish-tab.active { border-color: #303731; background: #303731; color: #FFFFFF; font-weight: 650; }
.recipe-card { margin-top: 28rpx; padding: 28rpx; overflow: hidden; border: 1rpx solid #E1DDD4; border-radius: 30rpx; background: #FFFFFF; box-shadow: 0 10rpx 34rpx rgba(54,49,42,.05); }
.recipe-head { display: flex; align-items: center; gap: 18rpx; }
.dish-thumb { width: 88rpx; height: 88rpx; flex: none; border-radius: 21rpx; background: #D5D0C7; }
.dish-thumb.placeholder { background: linear-gradient(145deg,#DDD6CB,#BFC8BF); }
.recipe-title { display: block; color: #313631; font-size: 31rpx; font-weight: 700; }
.recipe-caption { display: block; margin-top: 5rpx; color: #999C95; font-size: 20rpx; }
.recipe-poster { display: block; width: 100%; margin-top: 26rpx; border-radius: 23rpx; background: #EEEAE3; }
.poster-helper { display: block; margin-top: 10rpx; color: #9B9E97; font-size: 19rpx; text-align: center; }
.recipe-section { position: relative; margin-top: 28rpx; padding: 26rpx 24rpx 24rpx; border-radius: 22rpx; background: #F7F4EE; }
.recipe-section.tip-section { background: #EDF2ED; }
.section-index { color: #AE725E; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.section-title { display: block; margin-top: 5rpx; color: #3C423D; font-size: 26rpx; font-weight: 680; }
.section-content { display: block; margin-top: 15rpx; color: #626761; font-size: 23rpx; line-height: 1.82; white-space: pre-wrap; word-break: break-word; }
.no-recipe { padding: 70rpx 22rpx 50rpx; text-align: center; }
.no-recipe-title { display: block; color: #555B55; font-size: 27rpx; font-weight: 650; }
.no-recipe-copy { display: block; margin-top: 12rpx; color: #969A93; font-size: 22rpx; line-height: 1.7; }
.detail-note { margin-top: 20rpx; padding: 24rpx 27rpx; border: 1rpx solid #E1DDD4; border-radius: 24rpx; background: #FFFFFF; }
.note-label { display: block; color: #9A776A; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.note-copy { display: block; margin-top: 9rpx; color: #626761; font-size: 23rpx; line-height: 1.65; }
.bottom-space { height: calc(150rpx + env(safe-area-inset-bottom)); }
.detail-action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(220,215,206,.9); background: rgba(250,249,246,.96); box-shadow: 0 -12rpx 38rpx rgba(49,52,48,.08); }
.detail-action { display: flex; width: 100%; height: 88rpx; align-items: center; justify-content: center; border-radius: 22rpx; font-size: 26rpx; font-weight: 680; line-height: 1; }
.detail-action.primary { background: #2D332F; color: #FFFFFF; }
.detail-action::after { border: 0; }
.waiting-copy, .completed-copy { display: flex; min-height: 76rpx; align-items: center; justify-content: center; color: #7F847D; font-size: 22rpx; text-align: center; }
.completed-copy { color: #58675E; }
