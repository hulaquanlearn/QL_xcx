page { background: #F6F4EF; }
.activity-page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.page-intro { padding: 24rpx 4rpx 34rpx; }
.page-kicker, .modal-kicker { display: block; color: #A27C6E; font-size: 18rpx; font-weight: 650; letter-spacing: 4rpx; }
.page-title { display: block; margin-top: 10rpx; color: #282C27; font-size: 42rpx; font-weight: 700; }
.page-desc { display: block; margin-top: 10rpx; color: #858981; font-size: 24rpx; }
.view-switch { display: grid; margin-bottom: 22rpx; padding: 7rpx; grid-template-columns: repeat(2,1fr); border: 1rpx solid #E1DDD4; border-radius: 22rpx; background: #fff; }
.view-item { display: flex; height: 66rpx; align-items: center; justify-content: center; border-radius: 16rpx; color: #8A8E87; font-size: 22rpx; }
.view-item.active { background: #EAEDE7; color: #4F5B53; font-weight: 680; }
.filter-card { display: grid; padding: 10rpx; grid-template-columns: repeat(3,1fr); border: 1rpx solid #E2DED5; border-radius: 26rpx; background: #fff; }
.filter-item { padding: 18rpx 8rpx; border-radius: 18rpx; text-align: center; }
.filter-item.active { background: #ECE8DF; }
.filter-count { display: block; color: #343833; font-size: 30rpx; font-weight: 700; }
.filter-label { display: block; margin-top: 2rpx; color: #92958E; font-size: 21rpx; }
.filter-item.active .filter-label { color: #5E655E; font-weight: 600; }
.tasks-container { margin-top: 24rpx; }
.task-card { margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid #E3DFD6; border-radius: 26rpx; background: #fff; }
.task-card.completed { background: #F1F2EE; }
.task-content { display: flex; min-height: 112rpx; padding: 24rpx; align-items: flex-start; }
.task-checkbox { display: flex; width: 40rpx; height: 40rpx; margin-top: 2rpx; flex-shrink: 0; align-items: center; justify-content: center; border: 2rpx solid #B9BAB4; border-radius: 50%; color: #fff; font-size: 22rpx; }
.task-checkbox.checked { border-color: #728277; background: #728277; }
.task-copy { flex: 1; margin-left: 20rpx; }
.task-title { display: block; color: #353934; font-size: 28rpx; font-weight: 600; }
.completed .task-title { color: #94978F; text-decoration: line-through; }
.task-desc, .task-meta { display: block; margin-top: 6rpx; color: #93968F; font-size: 22rpx; }
.task-photos { padding: 0 24rpx 22rpx; }
.task-photo-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; overflow: hidden; border-radius: 18rpx; }
.task-photo { width: 100%; height: 126rpx; background: #E4E0D8; }
.task-photo-count { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 24rpx; }
.task-actions { display: flex; border-top: 1rpx solid #EEEAE2; }
.action-btn { display: flex; flex: 1; min-height: 72rpx; padding: 14rpx 18rpx; align-items: center; justify-content: center; color: #737871; font-size: 23rpx; line-height: 1.4; text-align: center; }
.action-btn.photo-action { color: #596A5E; font-weight: 600; }
.action-btn + .action-btn { border-left: 1rpx solid #EEEAE2; }
.action-btn.delete { color: #A5574F; }
.floating-add-btn { position: fixed; right: 34rpx; bottom: calc(34rpx + env(safe-area-inset-bottom)); z-index: 20; display: flex; width: 94rpx; height: 94rpx; align-items: center; justify-content: center; border-radius: 30rpx; background: #2D332F; color: #fff; font-size: 42rpx; box-shadow: 0 16rpx 40rpx rgba(45,51,47,.25); }
.modal-overlay { position: fixed; inset: 0; z-index: 100; display: flex; padding: 32rpx; align-items: center; justify-content: center; background: rgba(35,38,34,.48); }
.modal-content { width: 100%; padding: 40rpx 34rpx 30rpx; border-radius: 36rpx; background: #fff; }
.modal-title { display: block; margin-top: 10rpx; font-size: 36rpx; font-weight: 700; }
.modal-input { width: 100%; height: 96rpx; margin-top: 30rpx; padding: 0 24rpx; border: 1rpx solid #DED9D0; border-radius: 20rpx; background: #FAF9F6; font-size: 28rpx; }
.modal-footer { display: grid; margin-top: 24rpx; grid-template-columns: repeat(2,1fr); gap: 14rpx; }
.modal-btn { display: flex; height: 86rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #EFECE5; color: #666B65; line-height: 1.4; text-align: center; }
.modal-btn.confirm { background: #2D332F; color: #fff; }
.timeline-list { margin-top: 8rpx; }
.timeline-event { display: grid; grid-template-columns: 36rpx 1fr; }
.timeline-rail { display: flex; flex-direction: column; align-items: center; }
.timeline-dot { width: 17rpx; height: 17rpx; margin-top: 34rpx; flex-shrink: 0; border: 5rpx solid #DDE4DD; border-radius: 50%; background: #647269; }
.timeline-line { width: 2rpx; min-height: 50rpx; flex: 1; background: #DDDAD2; }
.timeline-card { margin: 0 0 18rpx 8rpx; padding: 25rpx; border: 1rpx solid #E2DED5; border-radius: 25rpx; background: #fff; }
.timeline-head { display: flex; align-items: center; justify-content: space-between; }
.timeline-type { color: #7A8A7E; font-size: 18rpx; font-weight: 680; letter-spacing: 2rpx; }
.timeline-date { color: var(--text-secondary); font-size: 24rpx; }
.timeline-title { display: block; margin-top: 12rpx; color: #343934; font-size: 28rpx; font-weight: 680; }
.timeline-desc { display: block; margin-top: 7rpx; color: #848981; font-size: 22rpx; line-height: 1.6; }
.timeline-photos { display: grid; margin-top: 17rpx; grid-template-columns: repeat(4,1fr); gap: 7rpx; overflow: hidden; border-radius: 17rpx; }
.timeline-photo { width: 100%; height: 118rpx; background: #E6E2DA; }
.timeline-author { display: block; margin-top: 15rpx; color: var(--text-secondary); font-size: 24rpx; }
.task-upload-panel { margin: 24rpx 0; padding: 24rpx; border: 1rpx solid var(--border-color); border-radius: var(--radius-md); background: white; }
.task-upload-row { display: flex; gap: 16rpx; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid var(--border-color); }
.task-upload-preview { width: 80rpx; height: 80rpx; flex-shrink: 0; background: var(--bg-soft); border-radius: 12rpx; }
.task-upload-copy { flex: 1; min-width: 0; font-size: 26rpx; }
.task-upload-error { display: block; color: var(--danger-color); font-size: 24rpx; }
.task-upload-row button { min-width: 88rpx; min-height: 88rpx; font-size: 24rpx; color: var(--primary-dark); }
