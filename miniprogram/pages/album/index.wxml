<wxs module="utils">function includes(arr,value){if(!arr)return false;for(var i=0;i<arr.length;i++){if(arr[i]===value)return true;}return false;}module.exports.includes=includes;</wxs>
<view class="container album-page">
  <view class="page-intro"><text class="page-kicker">OUR MOMENTS</text><text class="page-title">共同相册</text><text class="page-desc">不追求完整，只留下真正喜欢的瞬间。</text></view>
  <view class="album-grid">
    <block wx:for="{{groupedAlbumList}}" wx:key="date">
      <view class="date-section"><text class="date-title">{{item.date}}</text><text class="date-count">{{item.photos.length}} 张</text></view>
      <view class="date-photos"><view wx:for="{{item.photos}}" wx:key="_id" class="photo-item {{selectMode && utils.includes(selectedPhotos, item._id) ? 'photo-selected' : ''}}"><image src="{{item.imgUrl}}" mode="aspectFill" class="photo-img" bindtap="previewImage" data-imgurl="{{item.imgUrl}}" data-id="{{item._id}}"></image><view wx:if="{{selectMode}}" class="photo-checkbox {{utils.includes(selectedPhotos, item._id) ? 'checked' : ''}}" bindtap="toggleSelect" data-id="{{item._id}}"><text wx:if="{{utils.includes(selectedPhotos, item._id)}}">✓</text></view></view></view>
    </block>
  </view>
  <view class="action-buttons"><view class="action-btn select-btn" bindtap="toggleSelectMode">{{selectMode ? '完成选择' : '管理'}}</view><view class="action-btn upload-btn" bindtap="chooseImage">上传照片</view></view>
  <view wx:if="{{selectMode && selectedPhotos.length > 0}}" class="batch-delete-btn" bindtap="batchDeletePhotos">删除已选 {{selectedPhotos.length}} 张</view>
  <view wx:if="{{albumList.length === 0 && !loading}}" class="empty-state"><view class="empty-icon">相</view><text class="empty-text">相册还是空的</text><text class="empty-subtext">上传一张最近喜欢的照片</text></view>
  <view wx:if="{{loading}}" class="loading-state"><view class="loading-spinner"></view><text class="loading-text">正在加载</text></view>
</view>
